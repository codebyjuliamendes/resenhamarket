POSTGRES_DB=resenhamarket
POSTGRES_USER=resenha
POSTGRES_PASSWORD=resenha_dev_change_me
APP_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
APP_CORS_ORIGINS=http://localhost:5173
APP_SEED_ENABLED=true
# varejo, farmacia, alimenticio ou todos
APP_SEED_CENARIO=todos
# true apaga produtos e movimentações e recarrega o cenário; volte para false depois
APP_SEED_RESET=false
WEB_PORT=5173

# A função de demonstração da Vercel (api/server.ts) também lê APP_JWT_SECRET (mínimo 32 bytes;
# gere com: openssl rand -base64 48). Configure-a em Project Settings > Environment Variables.
